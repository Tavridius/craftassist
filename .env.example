# Скопируй в .env и заполни при необходимости.
# По умолчанию всё работает на ДЕМО-API с публичным токеном (цены тестовые).

# --- Реальные цены аукциона (креды одобренного приложения TradeAssist) ---
# Бэкенд сам обменивает их на app-токен (services/oauth.py) и обновляет его.
# API_BASE=https://eapi.stalcraft.net
# API_CLIENT_ID=3296
# API_CLIENT_SECRET=<client secret из кабинета exbo.net>
# Fallback для демо — статический токен:
# API_TOKEN=<demo token>

# --- Регион ---
REGION=RU

# --- Кэш цен, сек ---
PRICE_CACHE_TTL=600

# --- Темп фонового воркера цен ---
# Лимит prod-API: 400 запросов/мин на приложение (~6.7/с).
# 0.25 → ~4/с: полный цикл по ~989 предметам ≈ 4.6 мин, запас лимита ~40%
# (из него же едят /history и внеочередной прогрев по кликам пользователей).
# AUCTION_MIN_INTERVAL=0.25

# --- Дерево крафта ---
# CRAFT_MAX_DEPTH=6
# CRAFT_MAX_VARIANTS=6
