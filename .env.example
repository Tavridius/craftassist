# Скопируй в .env и заполни при необходимости.
# По умолчанию всё работает на ДЕМО-API с публичным токеном (цены тестовые).

# --- Реальные цены аукциона (креды одобренного приложения TradeAssist) ---
# Бэкенд сам обменивает их на app-токен (services/oauth.py) и обновляет его.
# API_BASE=https://eapi.stalcraft.net
# API_CLIENT_ID=3296
# API_CLIENT_SECRET=<client secret из кабинета exbo.net>
# Fallback для демо — статический токен:
# API_TOKEN=<demo token>

# --- Регион ---
REGION=RU

# --- Кэш цен, сек ---
PRICE_CACHE_TTL=600

# --- Темп фонового воркера цен ---
# Лимит prod-API: 400 единиц/мин, КАЖДЫЙ запрос к аукциону стоит 2 единицы
# (lots и history, значение limit не влияет) → потолок 200 запросов/мин (~3.3/с).
# 0.35 → ~2.9/с, запас ~14% (из него же едят /history и внеочередной прогрев
# по кликам пользователей); полный цикл по ~989 предметам ≈ 6 мин.
# AUCTION_MIN_INTERVAL=0.35

# --- Дерево крафта ---
# CRAFT_MAX_DEPTH=6
# CRAFT_MAX_VARIANTS=6

# --- Биржа артефактов (снапшоты продаж по корзинам качество×заточка) ---
# Замеры по расписанию (МСК); ~103 артефакта × 1-3 страницы × 4 раза/сутки —
# < 0.3% лимита API. На демо-API не работает (additional пустой).
# ART_WATCH_ENABLED=1
# ART_WATCH_HOURS=1,7,13,19
# ART_WATCH_MAX_PAGES=3
# ART_MIN_SALES=5
# ART_KEEP_DAYS=35
# Живые лоты (цены калькулятора сборок, пока история < 7 дней):
# средняя из ART_LOTS_TOP самых дешёвых лотов корзины, цикл раз в ART_LOTS_MINUTES.
# BUILD_PRICE_SOURCE: auto (лоты → avg7d после недели) / lots / avg7d.
# ART_LOTS_ENABLED=1
# ART_LOTS_MINUTES=30
# ART_LOTS_MAX_PAGES=2
# ART_LOTS_TOP=5
# BUILD_PRICE_SOURCE=auto

# --- Авторизация пользователей (OAuth 2.0 через аккаунт EXBO) ---
# Внешний адрес приложения за прокси; redirect_uri = PUBLIC_BASE_URL + /auth/callback
# и должен быть зарегистрирован в приложении TradeAssist на exbo.net.
# Без этих значений (и кред выше) авторизация тихо выключена.
# PUBLIC_BASE_URL=https://stalzone-helper.ru/mvp
# SESSION_TTL_DAYS=30

# --- Админы (модерация комментов + DEV-редактор карты /dev/map) ---
# EXBO id через запятую. Свой id виден в тултипе ника в шапке сайта («EXBO ID …»).
# ADMIN_USER_IDS=490765
